<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_gen62_description">

    <xacro:arg name="ros2_control_hardware_plugin" default="gazebo_ros2_control/GazeboSystem"/>
    <xacro:arg name="ros2_control_plugin_filename" default="libgazebo_ros2_control.so"/>
    <xacro:arg name="ros2_control_plugin_name" default="gazebo_ros2_control"/>

    <link name="world"/>
    <joint name="fixed" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <xacro:include filename="$(find rm_description)/urdf/rm_gen62_gazebo.urdf" />

    <gazebo reference="base_link">
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="Link1">
        <material>Gazebo/White</material>
        <self_collide>false</self_collide>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="Link2">
        <material>Gazebo/White</material>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="Link3">
        <material>Gazebo/White</material>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="Link4">
        <material>Gazebo/White</material>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="Link5">
        <material>Gazebo/White</material>
        <gravity>false</gravity>
    </gazebo>
    <gazebo reference="Link6">
        <material>Gazebo/White</material>
        <gravity>false</gravity>
    </gazebo>

    <gazebo>
        <self_collide>true</self_collide>
    </gazebo>

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>$(arg ros2_control_hardware_plugin)</plugin>
        </hardware>
        <joint name="joint1">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint2">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint3">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint4">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint5">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="joint6">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="$(arg ros2_control_plugin_filename)" name="$(arg ros2_control_plugin_name)">
            <parameters>$(find rm_gen62_config)/config/ros2_controllers.yaml</parameters>
            <robot_param>robot_description</robot_param>
            <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
    </gazebo>

</robot>
