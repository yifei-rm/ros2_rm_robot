<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_gen62">
    <!-- Match Gazebo's TF tree; the non-Gazebo model adds an unpublished base_root. -->
    <xacro:arg name="link6_type" default="Link6" />
    <xacro:include filename="$(find rm_description)/urdf/rm_gen62_gazebo.urdf" />
</robot>
