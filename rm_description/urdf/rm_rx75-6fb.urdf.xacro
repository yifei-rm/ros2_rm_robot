<?xml version="1.0" encoding="utf-8"?>
<robot name="rm_rx75_dual" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="left_xyz" default="0 -0.075 1.5" />
  <xacro:arg name="left_rpy" default="3.14 1.57 1.5707963267949" />
  <xacro:arg name="right_xyz" default="0 0.075 1.5" />
  <xacro:arg name="right_rpy" default="3.14 1.57 -1.5707963267949" />

  <!-- Keep a massless root so downstream KDL/MoveIt consumers have a clean tree root. -->
  <link name="base_root" />

  <joint name="left_base_mount" type="fixed">
    <origin xyz="$(arg left_xyz)" rpy="$(arg left_rpy)" />
    <parent link="base_root" />
    <child link="left_base_link" />
  </joint>

  <joint name="right_base_mount" type="fixed">
    <origin xyz="$(arg right_xyz)" rpy="$(arg right_rpy)" />
    <parent link="base_root" />
    <child link="right_base_link" />
  </joint>

